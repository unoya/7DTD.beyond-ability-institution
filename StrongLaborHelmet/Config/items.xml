<configs>
	<append xpath="/items">
		<item name="StrongLaborHelmet">
			<property name="Tags" value="head,armor,armorHead,lightarmor"/>
			<property name="Extends" value="armorMiningHelmet"/>
			<property name="CustomIcon" value="armorMiningHelmet"/><property name="CustomIconTint" value="02df82"/>
			<property name="Waterproof" value="0.5"/>
			<property name="Weight" value="20"/>
			<property name="EconomicValue" value="1000000"/>
			<property name="EquipSlot" value="Head"/>
			<effect_group>
				<passive_effect name="ModSlots" operation="base_set" value="0,5" tier="1,6"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="12"/><!-- 物理抗性 -->
				<passive_effect name="BuffResistance" operation="base_add" value="0.5" tags="buffIllInfection0,buffInjuryBleeding,buffInjuryStunned1"/>
				<passive_effect name="DegradationMax" operation="base_set" value="120,300" tier="1,6"/><!-- 耐久值 -->
				<passive_effect name="NoiseMultiplier" operation="perc_subtract" value="0.05" /><!-- 噪音值 -->
				<passive_effect name="Mobility" operation="perc_add" value="0.05"/><!-- 行動能力 -->
				<passive_effect name="StaminaChangeOT" operation="perc_subtract" value="-1.9" tags="walking"/><!-- 走路時的耐力值 -->
				<passive_effect name="StaminaChangeOT" operation="perc_subtract" value="-1.9" tags="running"/><!-- 跑步時的耐力值 -->
				<passive_effect name="HypothermalResist" operation="base_add" value="20"/><!-- 水抗性 -->
				<passive_effect name="HyperthermalResist" operation="base_add" value="20"/><!-- 火抗性 -->
				<passive_effect name="ScavengingTime" operation="perc_subtract" value="0.1,0.5" tier="1,6"/><!-- 找垃圾時間 -->
				<passive_effect name="HarvestCount" operation="perc_add" value="0.5,2" tier="1,6"/><!-- 收割數量 -->
				<display_value name="dStaminaChangeOT" value="10"/>
				<passive_effect name="LootGamestage" operation="base_add" value="250,1000" tier="1,6"/><!-- 掉寶率 -->
			</effect_group>
		</item>
	</append>
</configs>