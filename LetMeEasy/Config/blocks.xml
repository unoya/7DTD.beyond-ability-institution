<configs>
	<!-- 刀片陷阱, 反傷損害, 切碎目標的機率, 打殘目標的機率, 耐久值, 電力需求 -->
	<set xpath="/blocks/block[@name='bladeTrap']/property[@name='DamageReceived']/@value">1</set>
	<set xpath="/blocks/block[@name='bladeTrap']/property[@name='BreakingPercentage']/@value">0.8</set>
	<set xpath="/blocks/block[@name='bladeTrap']/property[@name='BrokenPercentage']/@value">0.5</set>
	<set xpath="/blocks/block[@name='bladeTrap']/property[@name='MaxDamage']/@value">10000</set>
	<set xpath="/blocks/block[@name='bladeTrap']/property[@name='RequiredPower']/@value">10</set>
	<!-- 感電柵欄陷阱, 耐久值, 電力需求 -->
	<set xpath="/blocks/block[@name='electricfencepost']/property[@name='MaxDamage']/@value">2000</set>
	<set xpath="/blocks/block[@name='electricfencepost']/property[@name='RequiredPower']/@value">2</set>
	<!-- 自動砲塔, 連續射擊的次數, 冷卻時間, 低頭休息時間, 電力需求, 最大射程, 射線擴散度 -->
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='BustRoundCount']/@value">100</set>
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='CooldownTime']/@value">0.5</set>
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='FallAsleepTime']/@value">1</set>
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='RequiredPower']/@value">10</set>
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='MaxDistance']/@value">50</set>
	<set xpath="/blocks/block[@name='autoTurret']/property[@name='RaySpread']/@value">3.5</set>
	<!-- 中繼器, 電力需求 -->
	<set xpath="/blocks/block[@name='electricwirerelay']/property[@name='RequiredPower']/@value">0</set>
	<!-- 警報器, 電力需求 -->
	<set xpath="/blocks/block[@name='speaker']/property[@name='RequiredPower']/@value">1</set>
	<!-- 發電機, 燃料最大容量 -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='MaxFuel']/@value">5000</set>
	
	<!-- 農作物成長時間, 樹木成長時間
	<set xpath="/blocks/block[@name='cropsGrowingMaster']/property[@name='PlantGrowing.GrowthRate']/@value">4</set>
	<set xpath="/blocks/block[@name='treeMasterGrowing']/property[@name='PlantGrowing.GrowthRate']/@value">4</set>
	-->
	
	<!-- 減少鋼筋升級成未凝固水泥塊所需的材料量 -->
	<set xpath="/blocks/block[@name='rebarFrameMaster']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">1</set>
	<set xpath="/blocks/block[@name='rebarFramePillar100']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">1</set>
	<!-- 減少強化水泥塊升級成鋼板塊所需的材料量 -->
	<set xpath="/blocks/block[@name='rConcreteMaster']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">1</set>
	<!-- 減少強化水泥塊修復時所需的材料量 -->
	<set xpath="/blocks/block[@name='rConcreteMaster']/property[@class='RepairItems']/property[@name='resourceConcreteMix']/@value">1</set>
	<!-- 減少鋼板塊修復時所需的材料量 -->
	<set xpath="/blocks/block[@name='steelMaster']/property[@class='RepairItems']/property[@name='resourceForgedSteel']/@value">1</set>
	<!-- 減少石板升級成未鵝卵石塊所需的材料量 -->
	<set xpath="/blocks/block[@name='flagstoneMaster']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">5</set>
	<!-- 減少鵝卵石塊升級成未凝固水泥塊所需的材料量 -->
	<set xpath="/blocks/block[@name='cobblestoneMaster']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">5</set>
	<!-- 減少凝固水泥塊升級成強化水泥塊所需的材料量 -->
	<set xpath="/blocks/block[@name='concreteMaster']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">5</set>
	<!-- 減少廢鐵外牆板升級成金屬鉚釘板所需的材料量, 修復所需的材料量 -->
	<set xpath="/blocks/block[@name='scrapIronSheet']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">2</set>
	<set xpath="/blocks/block[@name='scrapIronSheet']/property[@class='RepairItems']/property[@name='resourceScrapIron']/@value">2</set>
	<!-- 減少金屬鉚釘板修復所需的材料量 -->
	<set xpath="/blocks/block[@name='metalRivetSheet']/property[@class='RepairItems']/property[@name='resourceForgedIron']/@value">1</set>
</configs>