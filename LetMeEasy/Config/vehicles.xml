<configs>
	<!-- 調整交通工具的常速與加速, 以及每多少公里消耗1個燃料量 -->
	<!-- 直升機 -->
	<set xpath="/vehicles/vehicle[@name='vehicleGyrocopter']/property[@name='velocityMax']/@value">8,24</set>
	<set xpath="/vehicles/vehicle[@name='vehicleGyrocopter']/property[@class='engine']/property[@name='fuelKmPerL'] /@value">16</set>
	<!-- 迷你摩托車 -->
	<set xpath="/vehicles/vehicle[@name='vehicleMinibike']/property[@name='velocityMax']/@value">8,20</set>
	<set xpath="/vehicles/vehicle[@name='vehicleMinibike']/property[@class='engine']/property[@name='fuelKmPerL'] /@value">21</set>
	<!-- 哈雷機車, 常速與加速, 燃料消耗量, 發動機最小扭力,最大扭力, 制動力矩	-->
	<set xpath="/vehicles/vehicle[@name='vehicleMotorcycle']/property[@name='velocityMax']/@value">11,22</set>
	<set xpath="/vehicles/vehicle[@name='vehicleMotorcycle']/property[@class='engine']/property[@name='fuelKmPerL'] /@value">30</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='motorTorqueMinQ']/@value">10000</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='motorTorqueMaxQ']/@value">50000</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='brakeTorque']/@value">10000</set>
	<set xpath="/vehicles/vehicle[@name='vehicleMotorcycle']/property[@name='upAngleMax']/@value">80</set>
	<!-- 四輪驅動汽車 -->
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='velocityMax']/@value">10,21</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@class='engine']/property[@name='fuelKmPerL'] /@value">12</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='motorTorqueMinQ']/@value">18000</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='motorTorqueMaxQ']/@value">80000</set>
	<set xpath="/vehicles/vehicle[@name='vehicle4x4Truck']/property[@name='brakeTorque']/@value">20000</set>
</configs>