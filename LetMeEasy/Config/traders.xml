<configs>
	<!-- 更改商人開業時間 -->
	<set xpath="/traders/trader_info[@id='1']/@open_time">4:00</set>
	<!-- 更改商人更換商品內容的天數 -->
	<set xpath="/traders/trader_info[@id='1']/@reset_interval">2</set>
	<!-- 更改商人販賣商品的數量 -->
	<set xpath="/traders/trader_info[@id='1']/@min_inventory">50</set>
	<set xpath="/traders/trader_info[@id='1']/@max_inventory">100</set>
	<!-- 更改世界各地的販賣機可收購玩家販賣的東西 -->
	<set xpath="/traders/trader_info[@id='4']/@allow_sell">true</set>
	<set xpath="/traders/trader_info[@id='4']/@min_inventory">13</set>
	<set xpath="/traders/trader_info[@id='4']/@max_inventory">100</set>
	<set xpath="/traders/trader_info[@id='4']/@min_items_swapped">42</set>
	<set xpath="/traders/trader_info[@id='4']/@max_items_swapped">42</set>
	<!-- 更改世界各地的販賣機販賣種類的數量 -->
	<set xpath="/traders/trader_info[@id='4']/trader_items/@count">all</set>
	<!-- 更改世界各地的販賣機增加其它販賣項目 -->
	<append xpath="/traders/trader_info[@id='4']/trader_items">
		<item group="ammo" count="10"/>
		<item group="ammoSupplies" count="10"/>
		<item name="ammoBlunderbuss" count="100,5000"/> <!-- 簡易彈藥 -->
	</append>
	<!-- 更改油頁岩販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceOilShale']/@count">5000,50000</set>
	<!-- 更改硝酸岩鹽粉販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourcePotassiumNitratePowder']/@count">5000,50000</set>
	<!-- 更改油販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceOil']/@count">5000,50000</set>
	<!-- 更改酸化物販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceAcid']/@count">5000,50000</set>
	<!-- 更改膠帶販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceDuctTape']/@count">5000,50000</set>
	<!-- 更改火藥販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceGunPowder']/@count">5000,50000</set>
	<!-- 更改鍛鐵販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceForgedIron']/@count">5000,50000</set>
	<!-- 更改鍛鋼販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceForgedSteel']/@count">5000,50000</set>
	<!-- 更改混合水泥販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='constructionSupplies']/item[@name='resourceConcreteMix']/@count">5000,50000</set>
	<!-- 更改水泥販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='constructionSupplies']/item[@name='resourceCement']/@count">5000,50000</set>
	<!-- 更改鋼筋(方塊)販售的數量 -->
	<set xpath="/traders/trader_item_groups/trader_item_group[@name='constructionSupplies']/item[@name='rebarFrameBlock']/@count">5000,50000</set>
	<!-- 增加血袋販售的數量 -->
	<setattribute xpath="/traders/trader_item_groups/trader_item_group[@name='medicine']/item[@name='medicalBloodBag']" name="count">1000,5000</setattribute>
</configs>