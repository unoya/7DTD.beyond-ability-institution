<configs>
	<insertBefore xpath="/lootcontainers/lootgroup[@name='questChallenge']">
		<lootgroup name="armorTitaniumSchematic" count="1">
			<item name="modArmorTitaniumHeavyPlatingSchematic"/>
			<item name="modArmorTitaniumLightPlatingSchematic"/>
		</lootgroup>
		<lootgroup name="armorTitaniumMods" count="1">
			<item name="modArmorTitaniumHeavyPlating"/>
			<item name="modArmorTitaniumLightPlating"/>
			<item name="modArmorAngelKiss"/>
			<item name="modArmorOnePunch"/>
		</lootgroup>
	</insertBefore>
	
	<!-- 書櫃 -->
	<append xpath="/lootcontainers/lootgroup[@name='rareBooks']">
		<item group="armorTitaniumSchematic" prob="0.01"/>
	</append>
	<!-- 防具三等級 -->
	<append xpath="/lootcontainers/lootgroup[@name='modArmorT3']">
		<item group="armorTitaniumMods" prob="0.01"/>
	</append>
	<!-- 稀有工具類 -->
	<append xpath="/lootcontainers/lootgroup[@name='rareTools']">
		<item name="TitaniumSledgehammer" prob="0.01"/>
	</append>
</configs>