<configs>
	<append xpath="/item_modifiers">
		<!-- 重型鈦護甲 -->
		<item_modifier name="modArmorTitaniumHeavyPlating" installable_tags="heavyarmor" modifier_tags="resistance" type="attachment">
			<property name="Tags" value="titanium"/>
			<property name="DisplayType" value="modArmorHeavy"/>
			<property name="Stacknumber" value="1"/>
			<property name="CustomIcon" value="modArmorSteelPlating"/>
			<property name="CustomIconTint" value="00e3e3"/>
			<property name="EconomicValue" value="2000"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="8,15" tier="1,6"/><!-- 物理抗性 -->
				<passive_effect name="DegradationMax" operation="base_add" value="100,200" tier="1,6"/><!-- 裝備耐久值 -->
			</effect_group>
		</item_modifier>
		<!-- 輕型鈦護甲 -->
		<item_modifier name="modArmorTitaniumLightPlating" installable_tags="lightarmor" blocked_tags="padded" modifier_tags="resistance" type="attachment">
			<property name="Tags" value="titanium"/>
			<property name="DisplayType" value="modArmorLight"/>
			<property name="Stacknumber" value="1"/>
			<property name="CustomIcon" value="modArmorReinforcedPadding"/>
			<property name="CustomIconTint" value="00e3e3"/>
			<property name="EconomicValue" value="1500"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="5,10" tier="1,6"/><!-- 物理抗性 -->
				<passive_effect name="DegradationMax" operation="base_add" value="50,100" tier="1,6"/><!-- 裝備耐久值 -->
			</effect_group>
		</item_modifier>
		<!-- 天使之吻 -->
		<item_modifier name="modArmorAngelKiss" installable_tags="armorHead" modifier_tags="purifier" type="attachment">
			<property name="Tags" value="titanium,head,armor,armorHead"/>
			<property name="Stacknumber" value="1"/>
			<property name="Material" value="Msteel"/>
			<property name="CustomIcon" value="schematicMaster"/>
			<property name="CustomIconTint" value="8cea00"/>
			<property name="EconomicValue" value="1000"/>
			<effect_group tiered="false">
				<!-- 抵抗死亡懲罰, 疾病, 感染一二三級 -->
				<passive_effect name="BuffResistance" operation="base_add" value="1" tags="buffNearDeathTrauma,buffIllnessIndicator,buffIllInfection1,buffIllInfection2,buffIllInfection3"/>
			</effect_group>
		</item_modifier>
		<!-- 一拳的奧義 -->
		<item_modifier name="modArmorOnePunch" installable_tags="armorHands" modifier_tags="powerhand" type="attachment">
			<property name="Tags" value="titanium,hands,armorHands,armor"/>
			<property name="Stacknumber" value="1"/>
			<property name="Material" value="Msteel"/>
			<property name="CustomIcon" value="modArmorSpikedKnuckles"/>
			<property name="CustomIconTint" value="8cea00"/>
			<property name="EconomicValue" value="1000"/>
			<effect_group name="Base Effects" tiered="false">
				<passive_effect name="HealthMax" operation="perc_set" value="0.4"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="0.5" />
			</effect_group>
			<effect_group tiered="false">
				<requirement name="HoldingItemHasTags" tags="fists"/>
				<passive_effect name="EntityDamage" operation="base_add" value="1000000"/>
			</effect_group>
		</item_modifier>
	</append>
</configs>