<configs>
    <append xpath="/recipes">
		<!-- 扳手 -->
		<recipe name="meleeToolWrench" count="1" craft_time="10">
			<ingredient name="resourceForgedIron" count="100"/>
			<ingredient name="resourceOil" count="5"/>
			<ingredient name="resourceMetalPipe" count="2"/>
		</recipe>
		<!-- 酸化物 -->
		<recipe name="resourceAcid" count="1" craft_time="1">
			<ingredient name="resourceGlue" count="1"/>
			<ingredient name="resourceOil" count="1"/>
			<ingredient name="resourceScrapPolymers" count="1"/>
			<ingredient name="resourceCloth" count="5"/>
		</recipe>
		<!-- 小引擎 -->
		<recipe name="smallEngine" count="1" craft_area="workbench" craft_time="30">
			<ingredient name="resourceForgedIron" count="1000"/>
			<ingredient name="resourceSpring" count="4"/>
			<ingredient name="resourceMechanicalParts" count="10"/>
			<ingredient name="resourceElectricParts" count="10"/>
		</recipe>
		<!-- 電池 -->
		<recipe name="carBattery" count="1" craft_area="workbench" craft_time="10">
			<ingredient name="resourcePaper" count="100"/>
			<ingredient name="resourceDuctTape" count="100"/>
			<ingredient name="resourceScrapLead" count="100"/>
			<ingredient name="resourceScrapPolymers" count="100"/>
		</recipe>
		<!-- 太陽能電池 -->
		<recipe name="solarCell" count="1" craft_area="workbench" craft_time="10">
			<ingredient name="resourceBrokenGlass" count="1000"/>
			<ingredient name="resourceForgedSteel" count="10"/>
			<ingredient name="resourceScrapLead" count="100"/>
			<ingredient name="resourceElectricParts" count="100"/>
		</recipe>
		<!-- 燒杯 -->
		<recipe name="toolBeaker" count="1" craft_area="forge" material_based="true">
			<ingredient name="unit_glass" count="1000"/>
			<ingredient name="unit_clay" count="20"/>
		</recipe>
		<!-- 沖模工具 -->
		<recipe name="toolAndDieSet" count="1" craft_area="workbench" craft_time="5">
			<ingredient name="resourceForgedIron" count="1000"/>
			<ingredient name="resourceScrapBrass" count="100"/>
			<ingredient name="resourceScrapLead" count="100"/>
			<ingredient name="resourceMetalPipe" count="10"/>
		</recipe>
		<!-- 抽血器 -->
		<recipe name="medicalBloodDrawKit" count="1"  craft_time="1">
			<ingredient name="resourceMetalPipe" count="1"/>
			<ingredient name="resourceScrapPolymers" count="2"/>
		</recipe>
		<!-- 橄欖球帽 -->
		<recipe name="armorFootballHelmet" count="1" craft_area="workbench" craft_time="1">
			<ingredient name="resourceMilitaryFiber" count="10"/>
			<ingredient name="resourceForgedIron" count="5"/>
			<ingredient name="toolCookingGrill" count="1"/>
			<ingredient name="resourceLeather" count="2"/>
			<ingredient name="resourceNail" count="6"/>
		</recipe>
		<!-- 太陽能發電機 -->
		<recipe name="solarbank" count="1"  craft_area="workbench" craft_time="10">
			<ingredient name="resourceForgedIron" count="2000"/>
			<ingredient name="resourceBrokenGlass" count="1000"/>
			<ingredient name="resourceMechanicalParts" count="20"/>
			<ingredient name="resourceElectricParts" count="20"/>
			<ingredient name="resourceScrapPolymers" count="10"/>
		</recipe>
    </append>
</configs>